# Runtime files stay inside the project by default.
TRAFFIC_KNOWLEDGE_DATA_DIR=./data

# Hybrid retrieval defaults.
TRAFFIC_RETRIEVAL_VECTOR_WEIGHT=0.6
TRAFFIC_RETRIEVAL_BM25_WEIGHT=0.4
TRAFFIC_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# The forecasting service is reached through the local loopback interface.
TRAFFIC_FORECAST_BASE_URL=http://127.0.0.1:18000
TRAFFIC_REQUEST_TIMEOUT_SECONDS=10
TRAFFIC_MAX_FILE_BYTES=52428800

# Add a real key only to .env. Never commit it.
OPENAI_API_KEY=
